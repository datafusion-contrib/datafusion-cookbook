# Generated by Cargo
# will have compiled files and executables
/target/
recipes/*/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# Recipes are executables, and the whole point of them is that the exact
# versions here are known to build. Keep their lockfiles; CI builds --locked.
!recipes/*/Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

.idea

# Hugo
resources/_gen
public/
.hugo_build.lock
workdir/

# Python

__pycache__/
*.pyc
